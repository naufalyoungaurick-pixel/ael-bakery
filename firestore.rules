rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'naufalyoungaurick@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Perubahan menu: semua orang boleh melihat, hanya admin yang boleh mengubah
    match /menu_edit/{id} { allow read: if true; allow write: if admin(); }
    match /menu_baru/{id} { allow read: if true; allow write: if admin(); }
    // Pesanan: pelanggan membuat dan melihat pesanannya sendiri, admin melihat dan mengubah semua
    match /pesanan/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'baru';
      allow read: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if admin();
    }
  }
}
